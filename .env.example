# QR-Live 环境变量模板
#
# 用法：
#   * Docker 部署：cp .env.example .env（仓库根）。compose 会自动读取并注入容器；
#     没有 .env 时使用下列默认值。
#   * 本地开发：cp .env.example server/.env。server 的 dotenv 从进程工作目录读取 .env；
#     所有键经 Zod 校验，非法值启动即报错退出。
#   * 也可以直接用 shell 环境变量覆盖，优先级高于 .env（dotenv 不覆盖已存在的变量）。

# ── 服务端端口（容器内部） ──────────────────────────────────────────────
# 取值范围 1–65535。Caddy 按这两个端口反代；改端口需同步改 Caddyfile 的默认值。
PORT_HTTP=41601
PORT_WS=41602

# ── 通道生命周期 ────────────────────────────────────────────────────────
# 通道最后一次上传后的存活秒数，范围 60–86400（默认 1800 = 30 分钟）。
# 也是 POST /api/channel/create 未传 expire_seconds 时的默认 TTL。
CHANNEL_TTL_SECONDS=1800

# 过期通道的扫描间隔秒数，范围 10–3600。
# 过期还发生在读取时（惰性过期），因此实际存活时间不受扫描间隔影响。
CLEANUP_INTERVAL_SECONDS=60

# ── 限流与容量 ──────────────────────────────────────────────────────────
# 每通道每秒最大上传次数，范围 1–100。
UPLOAD_RATE_LIMIT=2

# 每 IP 每分钟最大通道创建次数，范围 1–1000。
CREATE_RATE_LIMIT=10

# 每通道最大 WebSocket 观看者数，范围 1–500；超限以关闭码 4002 拒绝。
MAX_VIEWERS_PER_CHANNEL=50

# 每 IP 每分钟最大分享码验证次数，范围 1–1000。
VERIFY_RATE_LIMIT=10

# 单个上传文本的最大长度（按 Unicode 码点计，不是 UTF-16 单元），范围 1–10000。
# JSON 请求体上限由它推导（至少 16 KiB），调大此值不会导致 413。
MAX_TEXT_LENGTH=2000

# ── 代理与安全 ──────────────────────────────────────────────────────────
# Express 的 trust proxy 设置，决定 req.ip 如何取值（影响限流键）。
#   loopback                （默认）只信任本机回环地址（同容器内 Caddy 反代即属此类）
#   false                   完全不信任 X-Forwarded-For
#   <数字>                  信任最近 N 跳代理
#   linklocal / uniquelocal 按网段信任
#   true                    信任全部（仅当整条链路可控时使用）
# 也接受 IP / CIDR 列表（逗号分隔）。放宽到 true 会让客户端自带 XFF 伪造限流键。
TRUST_PROXY=loopback

# WebSocket 握手的 Origin 白名单，逗号分隔（如 https://qr.example.com,https://qr.example.com:8443）。
# 留空 = 同源校验：Origin 的 host 必须等于请求 Host；无 Origin 的非浏览器客户端放行。
# 设为 * = 允许任意 Origin（不建议）。
WS_ALLOWED_ORIGINS=

# ── 部署（仅 docker compose / Caddy 使用；server 不读取） ────────────────
# 容器内 Caddy 的站点地址（Caddyfile 的 {$CADDY_SITE_ADDRESS}）：
#   :80              （默认）纯 HTTP，TLS 由外层网关/边缘终止
#   qr.example.com   Caddy 自行申请并续期证书（需发布 443、持久化 /srv/caddy/data，
#                    并确保外层没有别的代理替你终止 TLS）
# 说明：旧版的 CADDY_DOMAIN / CADDY_EMAIL 从未被任何代码读取，已删除；
#       需要 HTTPS 请只设置本键。
CADDY_SITE_ADDRESS=:80

# 宿主机发布的 HTTP 端口（docker-compose.yml 里 ports 的左侧），默认 41606。
# 容器内始终监听 80；本地开发直连 41601/41602/41605，不经过此端口。
LIVE_QR_PORT=41606
